{
  "expo": {
    "name": "FBT Controle",
    "slug": "fbt-controle",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B192C"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B192C"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O FBT Controle usa suas fotos para você anexar imagens às avaliações de produtos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O FBT Controle usa sua localização para ordenar os pontos de retirada do mais perto para o mais longe."
        }
      ],
      "expo-font"
    ]
  }
}
